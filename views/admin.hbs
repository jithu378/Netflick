<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Netflick | Admin Dashboard</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>
    <div class="admin-layout">
        <aside class="sidebar">
            <div class="sidebar-header">
                <a href="/netflick/admin/" class="logo">NETFLICK</a>
                <span>ADMIN PANEL</span>
            </div>

            <nav class="sidebar-menu" aria-label="Admin navigation">
                <a href="/netflick/admin" class="menu-item active" aria-current="page">
                    <i class="fa-solid fa-house" aria-hidden="true"></i>
                    Dashboard
                </a>
                <a href="/content/display-movies" class="menu-item">
                    <i class="fa-solid fa-film" aria-hidden="true"></i>
                    Movies
                </a>
                <a href="/content/display-show" class="menu-item">
                    <i class="fa-solid fa-tv" aria-hidden="true"></i>
                    TV Shows
                </a>
                <a href="/content/display-category" class="menu-item">
                    <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                    Categories
                </a>
                <a href="/netflick" class="menu-item back-link">
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                    Back to Netflick
                </a>
            </nav>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <h1>Dashboard</h1>
            </header>

            <div class="dashboard-content">
                <section class="welcome-section" id="dashboard">
                    <div class="welcome-copy">
                        <span class="welcome-label">CONTENT MANAGEMENT</span>
                        <h2>Welcome to Netflick Admin</h2>
                        <p>Manage your movies, TV shows and categories in one place.</p>
                    </div>
                    <div class="welcome-mark" aria-hidden="true">
                        <i class="fa-solid fa-clapperboard"></i>
                    </div>
                </section>

                <section class="stats-grid" aria-label="Content statistics">
                    <article class="stat-card">
                        <span class="stat-icon"><i class="fa-solid fa-film" aria-hidden="true"></i></span>
                        <div class="stat-copy">
                            <span>Total Movies</span>
                            <strong>&mdash;</strong>
                        </div>
                    </article>
                    <article class="stat-card">
                        <span class="stat-icon"><i class="fa-solid fa-tv" aria-hidden="true"></i></span>
                        <div class="stat-copy">
                            <span>Total TV Shows</span>
                            <strong>&mdash;</strong>
                        </div>
                    </article>
                    <article class="stat-card">
                        <span class="stat-icon"><i class="fa-solid fa-layer-group" aria-hidden="true"></i></span>
                        <div class="stat-copy">
                            <span>Total Categories</span>
                            <strong>&mdash;</strong>
                        </div>
                    </article>
                </section>

                <section class="content-section">
                    <div class="section-heading">
                        <h2>Quick Actions</h2>
                    </div>
                    <div class="action-grid">
                        <a href="/content/add-movie" class="action-card">
                            <span class="action-icon"><i class="fa-solid fa-film" aria-hidden="true"></i></span>
                            <span class="action-label">Add Movie</span>
                            <i class="fa-solid fa-arrow-right action-arrow" aria-hidden="true"></i>
                        </a>
                        <a href="/content/add-show" class="action-card">
                            <span class="action-icon"><i class="fa-solid fa-tv" aria-hidden="true"></i></span>
                            <span class="action-label">Add TV Show</span>
                            <i class="fa-solid fa-arrow-right action-arrow" aria-hidden="true"></i>
                        </a>
                        <a href="/content/add-category" class="action-card">
                            <span class="action-icon"><i class="fa-solid fa-layer-group" aria-hidden="true"></i></span>
                            <span class="action-label">Add Category</span>
                            <i class="fa-solid fa-arrow-right action-arrow" aria-hidden="true"></i>
                        </a>
                    </div>
                </section>
            </div>
        </main>
    </div>
</body>

</html>
