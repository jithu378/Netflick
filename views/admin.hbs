<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Dashboard | NETFLICK</title>

    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

    <div class="admin-layout">

        <!-- Sidebar -->
        <aside class="sidebar">

            <div class="sidebar-logo">
                NETFLICK<span>.</span>
            </div>

            <div class="sidebar-label">MAIN MENU</div>

            <nav class="sidebar-nav">

                <a href="/content/admin" class="nav-item active">
                    <span>▦</span>
                    Dashboard
                </a>

            </nav>

            <div class="sidebar-label management-label">CONTENT MANAGEMENT</div>

            <nav class="sidebar-nav">

                <a href="/content/manage-movies" class="nav-item">
                    <span>▣</span>
                    Movies
                </a>

                <a href="/content/manage-shows" class="nav-item">
                    <span>▤</span>
                    TV Shows
                </a>

                <a href="/content/manage-categories" class="nav-item">
                    <span>▧</span>
                    Categories
                </a>

            </nav>

            <div class="sidebar-bottom">
                <a href="/netflick" class="back-home">
                    <span>↩</span>
                    Back to Website
                </a>
            </div>

        </aside>


        <!-- Main Content -->
        <main class="admin-main">

            <!-- Topbar -->
            <header class="admin-topbar">

                <div>
                    <p class="topbar-subtitle">NETFLICK / ADMIN</p>
                    <h2>Dashboard</h2>
                </div>

                <div class="admin-profile">
                    <div class="profile-avatar">A</div>

                    <div>
                        <h4>Administrator</h4>
                        <p>Admin Panel</p>
                    </div>
                </div>

            </header>


            <!-- Welcome Section -->
            <section class="welcome-card">

                <div>
                    <p class="welcome-tag">ADMINISTRATION</p>

                    <h1>Welcome Back, Admin!</h1>

                    <p>
                        Manage your entertainment library and keep
                        your content collection organized.
                    </p>
                </div>

                <div class="welcome-decoration">
                    N
                </div>

            </section>


            <!-- Statistics -->
            <section class="stats-section">

                <div class="section-heading">
                    <div>
                        <h2>Overview</h2>
                        <p>Your content management summary</p>
                    </div>
                </div>


                <div class="stats-grid">

                    <div class="stat-card">

                        <div class="stat-top">
                            <span class="stat-icon">▣</span>
                            <span class="stat-label">CONTENT</span>
                        </div>

                        <h2>{{movieCount}}</h2>
                        <p>Total Movies</p>

                    </div>


                    <div class="stat-card">

                        <div class="stat-top">
                            <span class="stat-icon">▤</span>
                            <span class="stat-label">CONTENT</span>
                        </div>

                        <h2>{{showCount}}</h2>
                        <p>Total TV Shows</p>

                    </div>


                    <div class="stat-card">

                        <div class="stat-top">
                            <span class="stat-icon">▧</span>
                            <span class="stat-label">LIBRARY</span>
                        </div>

                        <h2>{{categoryCount}}</h2>
                        <p>Total Categories</p>

                    </div>


                    <div class="stat-card">

                        <div class="stat-top">
                            <span class="stat-icon">＋</span>
                            <span class="stat-label">COLLECTION</span>
                        </div>

                        <h2>{{totalContent}}</h2>
                        <p>Total Content</p>

                    </div>

                </div>

            </section>


            <!-- Quick Actions -->
            <section class="actions-section">

                <div class="section-heading">
                    <div>
                        <h2>Quick Actions</h2>
                        <p>Manage your entertainment collection</p>
                    </div>
                </div>


                <div class="actions-grid">

                    <a href="/content/add-movie" class="action-card">

                        <div class="action-icon">＋</div>

                        <div>
                            <h3>Add New Movie</h3>
                            <p>Add a movie to your collection.</p>
                        </div>

                        <span class="action-arrow">→</span>

                    </a>


                    <a href="/content/add-show" class="action-card">

                        <div class="action-icon">＋</div>

                        <div>
                            <h3>Add TV Show</h3>
                            <p>Add a new series to NETFLICK.</p>
                        </div>

                        <span class="action-arrow">→</span>

                    </a>


                    <a href="/content/add-category" class="action-card">

                        <div class="action-icon">＋</div>

                        <div>
                            <h3>Add Category</h3>
                            <p>Create a new content category.</p>
                        </div>

                        <span class="action-arrow">→</span>

                    </a>

                </div>

            </section>


            <!-- Footer -->
            <footer class="admin-footer">
                <p>© 2026 NETFLICK Admin Panel</p>
                <span>Manage your entertainment world.</span>
            </footer>

        </main>

    </div>

</body>

</html>