<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Netflick | TV Shows</title>

    <link rel="stylesheet" href="/css/style.css">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>

    <!-- Navbar -->
    <header class="navbar">

        <div class="nav-left">
            <a href="/netflick" class="logo">NETFLICK</a>

            <nav class="nav-links">
                <a href="/netflick">Home</a>
                <a href="/netflick/displayMovies">Movies</a>
                <a href="/netflick/displayShows" class="active">TV Shows</a>
                <a href="/netflick/displayCategories">Categories</a>
                <a href="/netflick/displayMyList">My List</a>
            </nav>
        </div>

        <div class="nav-right">

            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Search TV shows...">
            </div>

            <div class="profile">
                <i class="fa-solid fa-circle-user"></i>
            </div>

        </div>

    </header>


    <main class="container shows-page">

        <!-- Page Heading -->
        <section class="shows-heading">

            <div>
                <span class="section-label">YOUR COLLECTION</span>

                <h1>Explore TV Shows</h1>

                <p>Discover amazing series and unforgettable stories.</p>
            </div>

            <div class="movie-count">
                <i class="fa-solid fa-tv"></i>
                <span>{{shows.length}} Shows</span>
            </div>

        </section>


        <!-- TV Shows Collection -->

        <section class="shows-collection">

            {{#each shows}}

            <article class="movie-card show-card">

                <!-- Show Poster -->
                <div class="movie-poster show-poster">

                    {{#if showPoster}}
                    <img src="{{showPoster}}" alt="{{showTitle}} poster" class="poster-image"
                        onerror="this.remove()">
                    {{/if}}
                    <span class="movie-icon">
                        <i class="fa-solid fa-tv"></i>
                    </span>

                    <span class="movie-year">
                        {{showReleaseYear}}
                    </span>

                    <div class="poster-overlay">
                        <button type="button" title="View Show">
                            <i class="fa-solid fa-play"></i>
                        </button>
                    </div>

                </div>


                <!-- Show Details -->
                <div class="movie-details show-details">

                    <h3>{{showTitle}}</h3>

                    <!-- Genre and Rating -->
                    <div class="movie-meta">

                        <span class="genre">
                            <i class="fa-solid fa-tag"></i>
                            {{showGenre}}
                        </span>

                        <span class="rating">
                            <i class="fa-solid fa-star"></i>
                            {{showRating}}/10
                        </span>

                    </div>


                    <!-- Show Information -->
                    <div class="show-info">

                        <span>
                            <i class="fa-solid fa-layer-group"></i>
                            {{showTotalSeasons}} Seasons
                        </span>

                        <span>
                            <i class="fa-solid fa-list"></i>
                            {{showTotalEpisodes}} Episodes
                        </span>

                    </div>


                    <!-- View Details Button -->
                    <a href="/netflick/viewShow/{{_id}}" class="view-details-btn">
                        <i class="fa-solid fa-circle-info"></i>
                        View Details
                    </a>

                </div>

            </article>

            {{else}}

            <!-- Empty State -->
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="fa-solid fa-tv"></i>
                </div>

                <h3>No TV Shows Available</h3>

                <p>Your TV show collection is currently empty.</p>

                <a href="/netflick" class="back-home-btn">
                    Back to Home
                </a>

            </div>

            {{/each}}

        </section>


        <!-- Footer -->
        <footer class="footer">

            <div class="footer-left">
                <span class="footer-logo">NETFLICK</span>
                <p>Your personal entertainment collection.</p>
            </div>

            <div class="footer-right">
                <span>© 2026 Netflick</span>
                <span>Made for movie lovers.</span>
            </div>

        </footer>

    </main>

</body>
</html>
