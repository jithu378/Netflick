<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{viewShow.showTitle}} - Netflick</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/viewShow.css">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>

    <!-- Navbar -->
    <header class="navbar">

        <div class="nav-left">
            <a href="/netflick" class="logo">NETFLICK</a>

            <nav class="nav-links">
                <a href="/netflick">Home</a>
                <a href="/netflick/displayMovies">Movies</a>
                <a href="/netflick/displayShows" class="active">TV Shows</a>
                <a href="/netflick/displayCategories">Categories</a>
                <a href="/netflick/displayMyList">My List</a>
            </nav>
        </div>

        <div class="nav-right">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Search TV shows...">
            </div>

            <div class="profile">
                <i class="fa-solid fa-circle-user"></i>
            </div>
        </div>

    </header>


    <main class="container show-details-page">

        <!-- Breadcrumb / Back Link -->
        <div class="details-breadcrumb">
            <a href="/netflick/displayShows" class="back-link">
                <i class="fa-solid fa-arrow-left"></i>
                <span>Back to TV Shows</span>
            </a>
        </div>

        <!-- Cinematic Hero Section -->
        <section class="details-hero">

            <!-- Poster Column -->
            <div class="details-poster-card">
                <div class="poster-inner">
                    <span class="poster-main-icon">
                        <i class="fa-solid fa-tv"></i>
                    </span>

                    <span class="poster-year-badge">
                        {{viewShow.showReleaseYear}}
                    </span>

                    <div class="poster-quality-badge">
                        <span>SERIES HD</span>
                    </div>

                    <div class="poster-play-overlay">
                        <div class="play-pulse-btn">
                            <i class="fa-solid fa-play"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content Column -->
            <div class="details-hero-content">

                <!-- Tags Row -->
                <div class="details-tags">
                    <span class="tag-badge tag-type">
                        <i class="fa-solid fa-tv"></i>
                        TV Series
                    </span>
                    <span class="tag-badge tag-genre">
                        <i class="fa-solid fa-tag"></i>
                        {{viewShow.showGenre}}
                    </span>
                    <span class="tag-badge tag-lang">
                        <i class="fa-solid fa-globe"></i>
                        {{viewShow.showLanguage}}
                    </span>
                </div>

                <!-- Show Title -->
                <h1 class="show-details-title">{{viewShow.showTitle}}</h1>

                <!-- Meta Pills -->
                <div class="details-meta-bar">
                    <div class="meta-pill rating-pill">
                        <i class="fa-solid fa-star"></i>
                        <span class="rating-value">{{viewShow.showRating}}</span>
                        <span class="rating-scale">/10</span>
                    </div>

                    <div class="meta-pill">
                        <i class="fa-solid fa-layer-group"></i>
                        <span>{{viewShow.showTotalSeasons}} Seasons</span>
                    </div>

                    <div class="meta-pill">
                        <i class="fa-solid fa-list-ol"></i>
                        <span>{{viewShow.showTotalEpisodes}} Episodes</span>
                    </div>

                    <div class="meta-pill">
                        <i class="fa-regular fa-calendar"></i>
                        <span>{{viewShow.showReleaseYear}}</span>
                    </div>

                    <div class="meta-pill">
                        <i class="fa-solid fa-language"></i>
                        <span>{{viewShow.showLanguage}}</span>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="details-action-buttons">
                    <button type="button" class="details-btn btn-watch">
                        <i class="fa-solid fa-play"></i>
                        <span>Watch S1 E1</span>
                    </button>

                    <a href="/netflick/displayMyList" class="details-btn btn-list">
                        <i class="fa-solid fa-plus"></i>
                        <span>Add to My List</span>
                    </a>

                    <button type="button" class="details-icon-btn" title="Like">
                        <i class="fa-regular fa-thumbs-up"></i>
                    </button>

                    <button type="button" class="details-icon-btn" title="Share">
                        <i class="fa-solid fa-share-nodes"></i>
                    </button>
                </div>

                <!-- Storyline / Description Block -->
                <div class="storyline-block">
                    <h3>Storyline</h3>
                    <p class="storyline-text">{{viewShow.showDescription}}</p>
                </div>

            </div>

        </section>


        <!-- Detailed Specifications Grid -->
        <section class="details-specs-section">

            <div class="specs-header">
                <span class="section-label">OVERVIEW</span>
                <h2>Series Information & Statistics</h2>
            </div>

            <div class="specs-grid">

                <div class="spec-card">
                    <div class="spec-icon">
                        <i class="fa-solid fa-heading"></i>
                    </div>
                    <div class="spec-info">
                        <span class="spec-label">Series Title</span>
                        <strong class="spec-value">{{viewShow.showTitle}}</strong>
                    </div>
                </div>

                <div class="spec-card">
                    <div class="spec-icon">
                        <i class="fa-solid fa-masks-theater"></i>
                    </div>
                    <div class="spec-info">
                        <span class="spec-label">Genre</span>
                        <strong class="spec-value">{{viewShow.showGenre}}</strong>
                    </div>
                </div>

                <div class="spec-card">
                    <div class="spec-icon">
                        <i class="fa-regular fa-calendar-check"></i>
                    </div>
                    <div class="spec-info">
                        <span class="spec-label">Release Year</span>
                        <strong class="spec-value">{{viewShow.showReleaseYear}}</strong>
                    </div>
                </div>

                <div class="spec-card">
                    <div class="spec-icon">
                        <i class="fa-solid fa-globe"></i>
                    </div>
                    <div class="spec-info">
                        <span class="spec-label">Language</span>
                        <strong class="spec-value">{{viewShow.showLanguage}}</strong>
                    </div>
                </div>

                <div class="spec-card">
                    <div class="spec-icon">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                    <div class="spec-info">
                        <span class="spec-label">Total Seasons</span>
                        <strong class="spec-value">{{viewShow.showTotalSeasons}} Seasons</strong>
                    </div>
                </div>

                <div class="spec-card">
                    <div class="spec-icon">
                        <i class="fa-solid fa-list-ol"></i>
                    </div>
                    <div class="spec-info">
                        <span class="spec-label">Total Episodes</span>
                        <strong class="spec-value">{{viewShow.showTotalEpisodes}} Episodes</strong>
                    </div>
                </div>

                <div class="spec-card">
                    <div class="spec-icon">
                        <i class="fa-solid fa-star"></i>
                    </div>
                    <div class="spec-info">
                        <span class="spec-label">Rating</span>
                        <strong class="spec-value">{{viewShow.showRating}} / 10</strong>
                    </div>
                </div>

            </div>

        </section>


        <!-- Footer -->
        <footer class="footer">

            <div class="footer-left">
                <span class="footer-logo">NETFLICK</span>
                <p>Your personal entertainment collection.</p>
            </div>

            <div class="footer-right">
                <span>© 2026 Netflick</span>
                <span>Made for movie lovers.</span>
            </div>

        </footer>

    </main>

</body>

</html>
