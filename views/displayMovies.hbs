<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Netflick | All Movies</title>

    <link rel="stylesheet" href="/css/style.css">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>

    <!-- Navbar -->
    <header class="navbar">

        <div class="nav-left">
            <a href="/netflick" class="logo">NETFLICK</a>

            <nav class="nav-links">
                <a href="/netflick">Home</a>
                <a href="/netflick/displayMovies" class="active">Movies</a>
                <a href="/netflick/displayShows">TV Shows</a>
                <a href="/netflick/displayCategories">Categories</a>
                <a href="/netflick/displayMyList">My List</a>
            </nav>
        </div>

        <div class="nav-right">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Search movies...">
            </div>

            <div class="profile">
                <i class="fa-solid fa-circle-user"></i>
            </div>
        </div>

    </header>


    <main class="container movies-page">

        <!-- Page Heading -->
        <section class="movies-heading">

            <div>
                <span class="section-label">YOUR COLLECTION</span>
                <h1>Explore Movies</h1>
                <p>Discover your next favourite movie.</p>
            </div>

            <div class="movie-count">
                <i class="fa-solid fa-film"></i>
                <span>{{movies.length}} Movies</span>
            </div>

        </section>


        <!-- Movie Collection -->
        {{#if movies}}

        <section class="movie-grid">

            {{#each movies}}

            <article class="movie-card">

                <div class="movie-poster">

                    {{#if moviePoster}}
                    <img src="{{moviePoster}}" alt="{{movieTitle}} poster" class="poster-image"
                        onerror="this.remove()">
                    {{/if}}
                    <span class="movie-icon">
                        <i class="fa-solid fa-film"></i>
                    </span>

                    <span class="movie-year">
                        {{movieReleaseYear}}
                    </span>

                    <div class="poster-overlay">
                        <button type="button" title="View Movie">
                            <i class="fa-solid fa-play"></i>
                        </button>
                    </div>

                </div>


                <div class="movie-details">

                    <h3>{{movieTitle}}</h3>

                    <div class="movie-meta">

                        <span class="genre">
                            <i class="fa-solid fa-tag"></i>
                            {{movieGenre}}
                        </span>

                        <span class="rating">
                            <i class="fa-solid fa-star"></i>
                            {{movieRating}}/10
                        </span>

                    </div>

                    <a href="/netflick/viewMovie/{{_id}}" class="view-details-btn">View Details</a>

                </div>

            </article>

            {{/each}}

        </section>

        {{else}}

        <section class="empty-state">

            <div class="empty-icon">
                <i class="fa-solid fa-film"></i>
            </div>

            <h3>No Movies Available</h3>

            <p>Your movie collection is currently empty.</p>

            <a href="/netflick" class="back-home-btn">
                Back to Home
            </a>

        </section>

        {{/if}}


        <!-- Footer -->
        <footer class="footer">

            <div class="footer-left">
                <span class="footer-logo">NETFLICK</span>
                <p>Your personal entertainment collection.</p>
            </div>

            <div class="footer-right">
                <span>© 2026 Netflick</span>
                <span>Made for movie lovers.</span>
            </div>

        </footer>

    </main>

</body>
</html>