<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add TV Show | Netflick Admin</title>
    <link rel="stylesheet" href="/css/add-form.css">
</head>

<body>

    <main class="form-container">

        <div class="form-header">
            <a href="/netflick/admin" class="back-link">← Back to Dashboard</a>
            <h1>Add TV Show</h1>
            <p>Add a new TV show to your Netflick library.</p>
        </div>

        <form action="/admin/add-show" method="POST" class="content-form">

            <div class="form-group">
                <label>Show Title</label>
                <input type="text" name="title" placeholder="Enter show title" required>
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea name="description" rows="4"
                    placeholder="Enter show description" required></textarea>
            </div>

            <div class="form-row">

                <div class="form-group">
                    <label>Genre</label>
                    <select name="genre" required>
                        <option value="">Select Genre</option>
                        {{#each categories}}
                        <option value="{{_id}}">{{name}}</option>
                        {{/each}}
                    </select>
                </div>

                <div class="form-group">
                    <label>Release Year</label>
                    <input type="number" name="releaseYear"
                        placeholder="e.g. 2026" min="1888" required>
                </div>

            </div>

            <div class="form-row">

                <div class="form-group">
                    <label>Language</label>
                    <select name="language" required>
                        <option value="">Select Language</option>
                        <option value="English">English</option>
                        <option value="Malayalam">Malayalam</option>
                        <option value="Hindi">Hindi</option>
                        <option value="Tamil">Tamil</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Total Seasons</label>
                    <input type="number" name="totalSeasons"
                        placeholder="e.g. 3" min="1" required>
                </div>

            </div>

            <div class="form-group">
                <label>Total Episodes</label>
                <input type="number" name="totalEpisodes"
                    placeholder="e.g. 24" min="1" required>
            </div>

            <div class="form-group">
                <label>Rating (0–10)</label>
                <input type="number" name="rating"
                    placeholder="e.g. 9.0" min="0" max="10"
                    step="0.1" required>
            </div>

            <button type="submit" class="submit-btn">Add TV Show</button>

        </form>

    </main>

</body>
</html>