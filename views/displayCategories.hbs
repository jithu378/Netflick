<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Netflick | Categories</title>

    <link rel="stylesheet" href="/css/style.css">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>

    <!-- Navbar -->
    <header class="navbar">

        <div class="nav-left">
            <a href="/netflick" class="logo">NETFLICK</a>

            <nav class="nav-links">
                <a href="/netflick">Home</a>
                <a href="/netflick/displayMovies">Movies</a>
                <a href="/netflick/displayShows">TV Shows</a>
                <a href="/netflick/displayCategories" class="active">Categories</a>
                <a href="/netflick/displayMyList">My List</a>
            </nav>
        </div>

        <div class="nav-right">

            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Search categories...">
            </div>

            <div class="profile">
                <i class="fa-solid fa-circle-user"></i>
            </div>

        </div>

    </header>


    <main class="container categories-page">

        <!-- Page Heading -->
        <section class="categories-heading">

            <div>
                <span class="section-label">BROWSE COLLECTION</span>

                <h1>Explore Categories</h1>

                <p>Find entertainment that matches your mood.</p>
            </div>

            <div class="movie-count">
                <i class="fa-solid fa-layer-group"></i>
                <span>{{categories.length}} Categories</span>
            </div>

        </section>


        <!-- Categories Grid -->
        <section class="categories-grid">

            {{#each categories}}

            <article class="category-card">

                <div class="category-icon">
                    <i class="fa-solid fa-film"></i>
                </div>

                <div class="category-details">
                    <h3>{{categoryName}}</h3>
                    <span>Explore Collection</span>
                </div>

                <div class="category-arrow">
                    <i class="fa-solid fa-arrow-right"></i>
                </div>

            </article>

            {{else}}

            <!-- Empty State -->
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="fa-solid fa-layer-group"></i>
                </div>

                <h3>No Categories Available</h3>

                <p>Your category collection is currently empty.</p>

                <a href="/netflick" class="back-home-btn">
                    Back to Home
                </a>

            </div>

            {{/each}}

        </section>


        <!-- Footer -->
        <footer class="footer">

            <div class="footer-left">
                <span class="footer-logo">NETFLICK</span>
                <p>Your personal entertainment collection.</p>
            </div>

            <div class="footer-right">
                <span>© 2026 Netflick</span>
                <span>Made for movie lovers.</span>
            </div>

        </footer>

    </main>

</body>
</html>