<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Categories | NETFLICK Admin</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/manage-content.css">
</head>

<body>
    <div class="admin-layout">
        <aside class="sidebar">
            <div class="sidebar-logo">NETFLICK<span>.</span></div>
            <div class="sidebar-label">MAIN MENU</div>
            <nav class="sidebar-nav">
                <a href="/content/admin" class="nav-item"><span>▦</span>Dashboard</a>
            </nav>
            <div class="sidebar-label management-label">CONTENT MANAGEMENT</div>
            <nav class="sidebar-nav">
                <a href="/content/manage-movies" class="nav-item"><span>▣</span>Movies</a>
                <a href="/content/manage-shows" class="nav-item"><span>▤</span>TV Shows</a>
                <a href="/content/manage-categories" class="nav-item active"><span>▧</span>Categories</a>
            </nav>
            <div class="sidebar-bottom">
                <a href="/netflick" class="back-home"><span>↩</span>Back to Website</a>
            </div>
        </aside>

        <main class="admin-main content-main">
            <header class="admin-topbar">
                <div>
                    <p class="topbar-subtitle">NETFLICK / ADMIN / CONTENT</p>
                    <h2>Categories</h2>
                </div>
                <div class="admin-profile">
                    <div class="profile-avatar">A</div>
                    <div><h4>Administrator</h4><p>Admin Panel</p></div>
                </div>
            </header>

            <section class="manage-heading">
                <div>
                    <h1>Manage Categories</h1>
                    <p>Organize the genres available in your library.</p>
                </div>
                <a href="/content/add-category" class="manage-add-button">＋ Add New Category</a>
            </section>

            {{#if categories.length}}
            <div class="manage-table-wrap">
                <table class="manage-table category-table">
                    <thead>
                        <tr>
                            <th>Category Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each categories}}
                        <tr>
                            <td><strong>{{categoryName}}</strong></td>
                            <td>
                                <div class="manage-actions">
                                    <a href="/content/edit-category/{{_id}}" class="manage-button update-button">Update</a>
                                    <form action="/content/delete-category/{{_id}}" method="POST"
                                        onsubmit="return confirm('Delete this category?');">
                                        <button type="submit" class="manage-button delete-button">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            {{else}}
            <section class="manage-empty">
                <div class="empty-symbol">▧</div>
                <h3>No categories yet</h3>
                <p>Add a category to organize your content.</p>
                <a href="/content/add-category" class="manage-add-button">＋ Add New Category</a>
            </section>
            {{/if}}

            <footer class="admin-footer">
                <p>© 2026 NETFLICK Admin Panel</p>
                <span>Manage your entertainment world.</span>
            </footer>
        </main>
    </div>
</body>

</html>