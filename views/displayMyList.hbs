<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My List | NETFLICK</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- Navbar -->
    <header class="navbar">

        <div class="nav-left">

            <a href="/netflick" class="logo">NETFLICK</a>

            <nav class="nav-links">
                <a href="/netflick">Home</a>
                <a href="/netflick/displayMovies">Movies</a>
                <a href="/netflick/displayShows">TV Shows</a>
                <a href="/netflick/displayCategories">Categories</a>
                <a href="/netflick/displayMyList" class="active">My List</a>
            </nav>

        </div>

    </header>


    <!-- My List Page -->
    <main class="my-list-page">

        <section class="my-list-heading">
            <h1>My List</h1>
            <p>Your personal collection of movies and shows.</p>
        </section>


        <!-- Empty State -->
        <section class="my-list-empty">

            <div class="my-list-icon">
                <span>▤</span>
            </div>

            <h2>Your List is Waiting</h2>

            <p>
                Your favourite movies and TV shows will appear here.
                Start exploring and discover something you'll love.
            </p>

            <a href="/netflick/displayMovies" class="my-list-btn">
                Explore Movies
            </a>

        </section>

    </main>


    <!-- Footer -->
    <footer class="footer">
        <p>© 2026 NETFLICK. All rights reserved.</p>
    </footer>

</body>

</html>