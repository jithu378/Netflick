<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#000000">
    <title>NETFLICK — Cinematic Intro</title>
    <link rel="stylesheet" href="/css/intro.css">
</head>
<body>
    <main class="intro-container" aria-label="NETFLICK cinematic introduction">
        <!-- 3D WebGL Canvas Viewport -->
        <div id="webgl-viewport" class="webgl-viewport" aria-hidden="true"></div>

        <!-- Cinematic Vignette & Atmospheric Contrast Overlay -->
        <div class="cinematic-vignette" aria-hidden="true"></div>

        <!-- Scene 5: NETFLICK Wordmark -->
        <div class="wordmark-stage" aria-hidden="true">
            <div class="wordmark-glow"></div>
            <h1 class="wordmark-text" aria-label="NETFLICK">NETFLICK</h1>
        </div>

        <!-- Manual Navigation / Skip Control -->
        <button type="button" class="intro-skip-btn" id="intro-skip-btn" aria-label="Skip intro">
            SKIP
        </button>
    </main>

    <!-- Browser ES Module Intro Controller -->
    <script type="module" src="/js/intro.js"></script>
</body>
</html>
